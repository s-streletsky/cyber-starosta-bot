BOT_BRAND_NAME=CyberStarostaBot
BOT_TOKEN=your_telegram_bot_token

# Bootstrap admins (comma-separated, several allowed).
# REQUIRED: the bot refuses to start without at least one admin.
# Get your ID from @userinfobot before first run.
# Roles are assigned from the bot: /promote, /demote, /remove, /sethead.
# An admin cannot be removed/demoted.
ADMIN_USER_IDS=

# Default './data' value is for testing purposes only.
# See README.md for details on how to configure DATA_DIR.
DATA_DIR=./data

TIMEZONE=Europe/Kyiv
